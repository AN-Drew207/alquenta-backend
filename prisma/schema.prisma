// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
  SUPERADMIN
}

enum PlanTier {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum PropertyType {
  HOUSE
  APARTMENT
  COMMERCIAL_SPACE
  OFFICE
  LAND
}

enum OperationType {
  RENT
  SALE
}

enum PropertyStatus {
  AVAILABLE
  RENTED_OR_SOLD
  CANCELLED
}

enum NotificationType {
  NEW_MESSAGE
}

enum NotificationStatus {
  PENDING
  READ
}

enum AccountType {
  OWNER
  AGENCY
  CLIENT
}

enum ReportReason {
  SCAM
  MISLEADING_INFO
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  PENDING
  DISMISSED
}

enum PropertyAnalyticsEventType {
  VIEW
  WHATSAPP_REVEAL
  MESSAGE_STARTED
}

enum DeviceType {
  MOBILE
  DESKTOP
  UNKNOWN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  pendingEmail String?
  emailVerified Boolean @default(true)
  passwordHash String
  name         String
  firstName    String
  lastName     String
  username     String?  @unique
  role         Role
  accountType  AccountType @default(CLIENT)
  planId       String?
  plan         Plan?    @relation(fields: [planId], references: [id])
  avatarUrl    String?
  bio          String?
  city         String?
  state        String?
  website      String?
  phone        String?
  altPhone     String?
  phoneVerified Boolean @default(false)
  showWhatsapp Boolean  @default(false)
  allowCalls   Boolean  @default(false)
  showEmail    Boolean  @default(false)
  notificationPrefs Json?
  privacyPrefs      Json?
  generalPrefs      Json?
  twoFactorEnabled  Boolean @default(false)
  deactivatedAt     DateTime?
  deactivatedBySuperadmin Boolean @default(false)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties               Property[]     @relation("AdminProperties")
  conversationsAsClient    Conversation[] @relation("ClientConversations")
  conversationsAsAdmin     Conversation[] @relation("AdminConversations")
  messages                 Message[]      @relation("MessageAuthor")
  notifications            Notification[]
  sessions                 Session[]
  favorites                Favorite[]
  reports                  Report[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
}

model Property {
  id            String         @id @default(uuid())
  adminId       String
  admin         User           @relation("AdminProperties", fields: [adminId], references: [id], onDelete: Cascade)
  title         String
  description   String
  address       String
  state         String
  municipality  String
  type          PropertyType
  operationType OperationType
  price         Decimal        @db.Decimal(12, 2)
  status        PropertyStatus @default(AVAILABLE)
  bedrooms      Int?
  bathrooms     Int?
  parkingSpaces Int?
  squareMeters  Decimal?       @db.Decimal(10, 2)
  images        String[]
  videos        String[]
  whatsapp      String?
  latitude      Float?
  longitude     Float?
  cancelledAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  conversations   Conversation[]
  favoritedBy     Favorite[]
  reports         Report[]
  analyticsEvents PropertyAnalyticsEvent[]

  @@index([status, type, state, municipality])
}

model Conversation {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  clientId   String
  client     User     @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  adminId    String
  admin      User     @relation("AdminConversations", fields: [adminId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  messages Message[]
  notifications Notification[]

  @@unique([propertyId, clientId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  notifications Notification[]

  @@index([conversationId, createdAt])
}

model Plan {
  id                  String   @id @default(uuid())
  tier                PlanTier @unique
  name                String
  monthlyPriceUsd     Decimal  @db.Decimal(6, 2)
  activeListingsLimit Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users User[]
}

model Notification {
  id              String             @id @default(uuid())
  recipientUserId String
  recipient       User               @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            NotificationType
  messageId       String?
  message         Message?           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId  String?
  conversation    Conversation?      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  text            String
  status          NotificationStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([recipientUserId, status])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

model Report {
  id         String       @id @default(uuid())
  propertyId String
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([status])
}

model PropertyAnalyticsEvent {
  id         String                     @id @default(uuid())
  propertyId String
  property   Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       PropertyAnalyticsEventType
  deviceType DeviceType?
  occurredAt DateTime                   @default(now())

  @@index([propertyId, type, occurredAt])
}
