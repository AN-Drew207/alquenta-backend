# Copy this file to .env and fill in real values. Never commit .env.
#
# See README-entornos.md for which values go with which environment
# (local / Render "alquenta-backend-dev" / Render "alquenta-backend").
#
# .env.render-dev and .env.render-prod (git-ignored, not auto-loaded by
# anything) mirror what's actually set in Render for each service, so you
# don't have to open the dashboard just to check a value. Keep them updated
# by hand if you change something in Render.

# Which deployment tier this process is running as. Used at boot to
# validate the rest of the environment and to guard against a non-production
# process accidentally pointing at the production database.
# One of: development | production | test
APP_ENV=development

# Node/Nest runtime mode. Usually mirrors APP_ENV locally, but hosting
# platforms may force this to "production" for build optimizations even on
# a non-production deployment — that's why APP_ENV exists separately.
# One of: development | production | test
NODE_ENV=development

# Port the HTTP server listens on. Render provides its own PORT; only needed
# for local development.
PORT=3001

# Postgres connection string for this environment's Neon branch (pooled
# connection — host ends in "-pooler"). Local/dev: the "develop" branch.
# Production: the "main" branch. NEVER put the production string in a
# non-production environment.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Same database as DATABASE_URL, but the direct (non-pooled) connection —
# host without "-pooler". Used only by `prisma migrate deploy`: PgBouncer's
# transaction-mode pooling can't hold the session-level advisory lock
# migrate needs, which times out with P1002. Required on Render (dev and
# prod); leave unset for a local database that isn't behind a pooler.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Comma-separated list of allowed frontend origins for CORS, and the base
# URL used to build links sent in emails (invites, email-change confirmation).
# Local: http://localhost:3000
# Render dev: the Vercel preview URL for the "develop" branch
# Render prod: the production frontend URL
FRONT_URL="http://localhost:3000"

# Secret used to sign session JWTs. Generate a distinct, random value per
# environment (e.g. `openssl rand -hex 32`) — never reuse the production
# secret anywhere else.
JWT_SECRET="change-me"

# Session JWT lifetime in seconds. Optional, defaults to 604800 (7 days).
JWT_EXPIRES_IN="604800"

# Resend (transactional email). Optional — email sending is skipped if unset.
RESEND_API_KEY=""
EMAIL_FROM=""

# Cloudinary (property photos / avatars). Optional — media upload endpoints
# return 503 if unset. Use separate folders per environment (see
# CLOUDINARY_FOLDER convention in README-entornos.md) even if the
# cloud name/keys are shared.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
